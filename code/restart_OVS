# kill existing ovs
sudo pkill ovs-vswitchd
sudo pkill ovsdb-server
# check
pgrep -fl ovsdb-server
pgrep -fl ovs-vswitchd
# Start new ovs
/etc/init.d/openvswitch-switch start
sudo rm -f ~/usr/local/etc/openvswitch/conf.db /usr/local/share/openvswitch/vswitch.ovsschema

sudo mkdir -p /usr/local/share/openvswitch/
sudo mkdir -p /usr/local/etc/openvswitch/
sudo ovsdb-tool create /usr/local/etc/openvswitch/conf.db /usr/local/share/openvswitch/vswitch.ovsschema
ovsdb-tool create /usr/local/share/openvswitch/vswitch.ovsschema
sudo ovsdb-server --remote=punix:/usr/local/var/run/openvswitch/db.sock --remote=db:Open_vSwitch,Open_vSwitch,manager_options --pidfile --detach --log-file

ovs-vsctl --no-wait init
ovs-vswitchd --pidfile --detach




