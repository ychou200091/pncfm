        <mxCell id="hxDirAN6QGu8-SEs3p0q-11" value="&lt;div&gt;Assisting flow is competing for resources with the local flows, use Nash Bargaining Module to limit rate on the assisting flow.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=40;spacing=6;" vertex="1" parent="1">
